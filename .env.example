POSTGRES_DB=ojcc
POSTGRES_USER=ojcc
POSTGRES_PASSWORD=local-synthetic-only
# Local-only role names and synthetic credentials used by the provisioning example.
OJCC_MIGRATION_USER=ojcc_migrator
OJCC_MIGRATION_PASSWORD=migrator-local-synthetic-only
OJCC_API_USER=ojcc_api
OJCC_API_PASSWORD=api-local-synthetic-only
# Set all three URLs to one freshly generated disposable database. There is no
# persistent fallback. BOOTSTRAP_DATABASE_URL is provisioning/reset-only.
BOOTSTRAP_DATABASE_URL=
MIGRATION_DATABASE_URL=
DATABASE_URL=
APP_ENV=local
# Set these only for the synthetic demo environment; never commit a production secret.
DEMO_SESSION_SECRET=
DEMO_SESSION_TTL_MINUTES=30
DEMO_ORGANIZATION_ID=
# Server-only JSON roster emitted by `python -m scripts.seed_demo --print-demo-actors`.
DEMO_ACTORS_JSON=
# Next's same-origin /api rewrite target for local development.
OJCC_API_ORIGIN=http://127.0.0.1:8000
